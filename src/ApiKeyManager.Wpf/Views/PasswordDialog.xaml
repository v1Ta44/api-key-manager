<Window x:Class="ApiKeyManager.Wpf.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请输入密码"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Back}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <!-- 全部用 StackPanel/Grid 自动排版，没有任何绝对坐标 -->
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Style="{StaticResource GlyphBadge}" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource GlyphBadgeIcon}" Text="&#xE72E;" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Style="{StaticResource TextDialogTitle}" Text="解锁" />
                    <TextBlock x:Name="TxtSubtitle" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 提示 -->
            <TextBlock x:Name="TxtPrompt" Style="{StaticResource TextBody}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <!-- 字段 1 -->
            <TextBlock x:Name="LblPwd1" Style="{StaticResource TextCaption}" Margin="0,0,0,4" Text="主密码" />
            <PasswordBox x:Name="Pwd1" Style="{StaticResource PasswordBoxBase}" />

            <!-- 字段 2（Change 模式 = 新密码；Create 模式 = 确认密码） -->
            <StackPanel x:Name="Block2" Visibility="Collapsed">
                <TextBlock x:Name="LblPwd2" Style="{StaticResource TextCaption}" Margin="0,12,0,4" />
                <PasswordBox x:Name="Pwd2" Style="{StaticResource PasswordBoxBase}" />
            </StackPanel>

            <!-- 字段 3（仅 Change 模式 = 确认新密码） -->
            <StackPanel x:Name="Block3" Visibility="Collapsed">
                <TextBlock Style="{StaticResource TextCaption}" Margin="0,12,0,4" Text="再次输入新密码以确认" />
                <PasswordBox x:Name="Pwd3" Style="{StaticResource PasswordBoxBase}" />
            </StackPanel>

            <!-- 校验提示 -->
            <TextBlock x:Name="TxtError" Style="{StaticResource TextCaption}"
                       Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnCancel" Style="{StaticResource ButtonSubtle}"
                        Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="BtnOk" Style="{StaticResource ButtonPrimary}"
                        Content="确定" Width="88" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
