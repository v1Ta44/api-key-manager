<Window x:Class="ApiKeyManager.Wpf.Views.EntryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑 API Key"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Back}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <!--
      这是与 WinForms 版对比最明显的地方：
      原版 Forms.cs 用 33 处 Location = new Point(x, y) 手工排版，
      加一个字段要重算所有后续 Y 坐标并改 ClientSize。
      这里用 Grid 的 Auto 行：加字段只需插入一行定义。
    -->
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border x:Name="Badge" Style="{StaticResource GlyphBadge}" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource GlyphBadgeIcon}" Text="&#xE710;" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Style="{StaticResource TextDialogTitle}" Text="新增 API Key" />
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0"
                               Text="保存后立即加密写入库文件" />
                </StackPanel>
            </StackPanel>

            <!--
              字段表：两列（标签 Auto / 输入 *），行全部 Auto。
              行间距由 RowDefinition + Margin 控制，不依赖像素坐标。
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 名称 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextFieldLabel}"
                           Margin="0,0,12,10" Text="名称 *" />
                <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource TextBoxBase}" Margin="0,0,0,10" />

                <!-- 提供商 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TextFieldLabel}"
                           Margin="0,0,12,10" Text="提供商" />
                <TextBox x:Name="TxtProvider" Grid.Row="1" Grid.Column="1"
                         Style="{StaticResource TextBoxBase}" Margin="0,0,0,10" />

                <!-- API Key -->
                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TextFieldLabel}"
                           Margin="0,0,12,10" Text="API Key" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PwdKey" Grid.Column="0" Style="{StaticResource PasswordBoxBase}" />
                    <TextBox x:Name="TxtKeyPlain" Grid.Column="0"
                             Style="{StaticResource TextBoxBase}" Visibility="Collapsed" />
                    <CheckBox x:Name="ChkShowKey" Grid.Column="1" Style="{StaticResource ThemedCheckBox}"
                              Content="显示" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <!-- Base URL -->
                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource TextFieldLabel}"
                           Margin="0,0,12,10" Text="Base URL" />
                <TextBox x:Name="TxtBaseUrl" Grid.Row="3" Grid.Column="1"
                         Style="{StaticResource TextBoxBase}" Margin="0,0,0,10" />

                <!-- 模型 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TextFieldLabel}"
                           Margin="0,0,12,10" Text="默认模型" />
                <TextBox x:Name="TxtModel" Grid.Row="4" Grid.Column="1"
                         Style="{StaticResource TextBoxBase}" Margin="0,0,0,10" />

                <!-- 标签 -->
                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource TextFieldLabel}"
                           Margin="0,0,12,10" Text="标签" />
                <TextBox x:Name="TxtTags" Grid.Row="5" Grid.Column="1"
                         Style="{StaticResource TextBoxBase}" Margin="0,0,0,10" />

                <!-- 到期日 -->
                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource TextFieldLabel}"
                           Margin="0,0,12,10" Text="到期日" />
                <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="PickExpiry" Grid.Column="0" Width="150"
                                VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="ChkNoExpiry" Style="{StaticResource ThemedCheckBox}"
                                  Content="不设置到期提醒" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtExpiryHint" Style="{StaticResource TextCaption}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 备注 -->
                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource TextFieldLabel}"
                           Margin="0,4,12,0" VerticalAlignment="Top" Text="备注" />
                <TextBox x:Name="TxtNotes" Grid.Row="7" Grid.Column="1"
                         Style="{StaticResource TextBoxMultiline}" />
            </Grid>

            <!-- 元信息 -->
            <TextBlock x:Name="TxtMeta" Style="{StaticResource TextCaption}" Margin="0,12,0,0" />

            <!-- 校验提示 -->
            <TextBlock x:Name="TxtError" Style="{StaticResource TextCaption}"
                       Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnCancel" Style="{StaticResource ButtonSubtle}"
                        Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="BtnSave" Style="{StaticResource ButtonPrimary}"
                        Content="保存" Width="88" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
