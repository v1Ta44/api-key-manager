<Window x:Class="ApiKeyManager.Wpf.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="480"
        MinWidth="480"
        MaxHeight="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Back}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <!--
      替代 MessageBox 的主题化弹窗。

      为什么不用 MessageBox：
      它是系统的 Win32 对话框，用系统配色与系统字体，
      完全不跟随应用的浅色/深色主题 —— 在深色模式下会突兀地弹出一个
      亮色窗口。自己画一个才能复用同一套令牌与 DynamicResource。

      布局要点：
      - 外层 ScrollViewer + 内层限宽，长文案（到期提醒会列多条记录）
        既不会把窗口撑宽，也不会被裁掉。
      - 按钮行永远在底部，不随内容多少漂移。
    -->
    <Border Style="{StaticResource Card}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Auto 而非 *：配合 SizeToContent="Height" 让窗口按内容长高；
                     内容超高时由 MaxHeight + ScrollViewer 兜底 -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行：徽标 + 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border x:Name="Badge" Style="{StaticResource GlyphBadge}" Margin="0,0,12,0">
                    <TextBlock x:Name="BadgeIcon" Style="{StaticResource GlyphBadgeIcon}" Text="&#xE946;" />
                </Border>
                <TextBlock x:Name="TxtHeading" Style="{StaticResource TextDialogTitle}"
                           VerticalAlignment="Center" Text="提示" />
            </StackPanel>

            <!-- 正文（可滚动，避免长内容被裁） -->
            <ScrollViewer Grid.Row="1" x:Name="Scroller"
                          MaxHeight="360"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TxtBody" Style="{StaticResource TextBody}"
                           TextWrapping="Wrap"
                           LineHeight="20" />
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnNo" Style="{StaticResource ButtonSubtle}"
                        Content="取消" Width="88" Margin="0,0,8,0"
                        Visibility="Collapsed" IsCancel="True" />
                <Button x:Name="BtnOk" Style="{StaticResource ButtonPrimary}"
                        Content="确定" Width="88" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
