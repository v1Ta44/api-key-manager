<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      测试项目保持 net9.0-windows：
      无障碍与主题一致性测试需要读取 WPF 项目目录下的 XAML 文件，
      这些断言按仓库路径定位文件，不加载 WPF 运行时本身。
      保持 -windows 目标是为了将来加"实例化窗口"的集成测试时不用改目标框架。
    -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ApiKeyManager.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      只引用 Core。
      Core 目标框架是 net9.0（无 -windows），这从编译期就保证了
      业务逻辑不会悄悄依赖 UI 类型 —— Core 里出现 System.Windows
      会直接编译失败，而不是等到运行时才炸。

      原先还引用了 WinForms 工程以测试自绘控件的 AccessibleName；
      WPF 版的无障碍测试改为解析 XAML，不再需要引用 UI 工程，
      因此这里去掉，测试项目也不必再开 UseWindowsForms。
    -->
    <ProjectReference Include="..\..\src\ApiKeyManager.Core\ApiKeyManager.Core.csproj" />
  </ItemGroup>

</Project>
