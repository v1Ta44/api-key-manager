<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="PBoolToVisibility" />
    <Style x:Key="PScrollPage" TargetType="RepeatButton">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource PScrollPage}" /></Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource PBorder}" CornerRadius="4" Margin="2,0" /></ControlTemplate></Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource PScrollPage}" /></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource PCaption}">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="PButton" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Background" Value="{DynamicResource PSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource PText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusBorder" BorderBrush="{DynamicResource PAccent}" BorderThickness="2" CornerRadius="8"
                                Margin="-3" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.82" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.62" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PPrimary" TargetType="Button" BasedOn="{StaticResource PButton}">
        <Setter Property="Background" Value="{DynamicResource PAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource POnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="PQuiet" TargetType="Button" BasedOn="{StaticResource PButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PMuted}" />
    </Style>
    <Style x:Key="PWindowGlyph" TargetType="Path">
        <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1" /><Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="PWindowControl" TargetType="Button" BasedOn="{StaticResource PButton}">
        <Setter Property="Width" Value="40" /><Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="2,0" /><Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource PMuted}" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Arrow" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PSubtle}" /><Setter Property="Foreground" Value="{DynamicResource PText}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PAccentSoft}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PWindowClose" TargetType="Button" BasedOn="{StaticResource PWindowControl}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PDangerSoft}" /><Setter Property="Foreground" Value="{DynamicResource PDanger}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PInput" TargetType="TextBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Foreground" Value="{DynamicResource PText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PAccent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PAccentSoft}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource PSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PAccent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PPassword" TargetType="PasswordBox">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Foreground" Value="{DynamicResource PText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Frame" Background="{DynamicResource PSurface}" BorderBrush="{DynamicResource PBorder}" BorderThickness="1" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PAccent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PSearch" TargetType="TextBox" BasedOn="{StaticResource PInput}">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="0" Focusable="False" /></ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="PFilter" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PMuted}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Frame" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PAccentSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource PAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PBorder}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PAccent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PListItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Frame" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource PSubtle}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PAccentSoft}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PAccent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PSelect" TargetType="ComboBox">
        <Setter Property="Height" Value="34" /><Setter Property="Foreground" Value="{DynamicResource PText}" />
        <Setter Property="Background" Value="{DynamicResource PSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource PBorder}" />
        <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PText}" /><Setter Property="Background" Value="{DynamicResource PSurface}" /><Setter Property="Padding" Value="12,8" />
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource PAccentSoft}" /></Trigger></Style.Triggers>
        </Style></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource PSurface}" BorderBrush="{DynamicResource PBorder}" BorderThickness="1" CornerRadius="6" /></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False" />
                <Border x:Name="SelectFocus" BorderBrush="{DynamicResource PAccent}" BorderThickness="2" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False" />
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                    <Border Background="{DynamicResource PSurface}" BorderBrush="{DynamicResource PBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                        <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectFocus" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
