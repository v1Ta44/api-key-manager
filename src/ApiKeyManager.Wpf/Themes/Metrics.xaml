<!--
  Metrics.xaml —— 尺寸令牌（DIP，设备无关单位）

  目的：消灭散落在代码里的魔法数。
  之前 WinForms 版里有 38(控件高) / 56(行距) / 96(首行Y) / 8(圆角) / 20(卡片内边距)
  等等硬编码值，同一个数字在不同地方含义还不一样。
  这里统一命名，改一处即可全局生效。

  间距刻度取 4 的倍数（4/8/12/16/24/32），这是通行的 8pt 网格的细分变体。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ 间距（8pt 网格）============ -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">24</sys:Double>
    <sys:Double x:Key="Space6">32</sys:Double>

    <Thickness x:Key="PadCard">24,20,24,20</Thickness>
    <Thickness x:Key="PadDialog">20</Thickness>
    <Thickness x:Key="PadField">12,0,12,0</Thickness>
    <Thickness x:Key="PadToolbar">0,0,0,12</Thickness>
    <Thickness x:Key="PadWindow">16,14,16,8</Thickness>

    <!-- ============ 圆角 ============ -->
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusChip">999</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">14</CornerRadius>

    <!-- ============ 控件尺寸 ============ -->
    <sys:Double x:Key="HeightControl">36</sys:Double>
    <sys:Double x:Key="HeightToolbarButton">34</sys:Double>
    <sys:Double x:Key="HeightRow">40</sys:Double>
    <sys:Double x:Key="HeightBadge">46</sys:Double>
    <sys:Double x:Key="HeightChip">22</sys:Double>
    <sys:Double x:Key="WidthFieldNarrow">160</sys:Double>
    <sys:Double x:Key="WidthSpinner">64</sys:Double>

    <!-- ============ 字号 ============ -->
    <sys:Double x:Key="FontSizeDisplay">20</sys:Double>
    <sys:Double x:Key="FontSizeTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeDialogTitle">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeMono">13</sys:Double>

    <!-- ============ 线宽 ============ -->
    <!-- 注意：BorderThickness 需要 Thickness 类型，不接受 Double。
         下面同时提供两种形式，用哪个取决于目标属性类型。 -->
    <sys:Double x:Key="StrokeThin">1</sys:Double>
    <sys:Double x:Key="StrokeFocus">2</sys:Double>
    <Thickness x:Key="BorderThin">1</Thickness>
    <Thickness x:Key="BorderFocus">2</Thickness>
    <Thickness x:Key="BorderBottomOnly">0,0,0,1</Thickness>

    <!-- ============ 窗口默认尺寸 ============ -->
    <sys:Double x:Key="WindowWidth">1180</sys:Double>
    <sys:Double x:Key="WindowHeight">720</sys:Double>
    <sys:Double x:Key="WindowMinWidth">980</sys:Double>
    <sys:Double x:Key="WindowMinHeight">560</sys:Double>

    <!-- ============ 动效时长 ============ -->
    <Duration x:Key="DurationFast">0:0:0.12</Duration>
    <Duration x:Key="DurationNormal">0:0:0.2</Duration>

</ResourceDictionary>
