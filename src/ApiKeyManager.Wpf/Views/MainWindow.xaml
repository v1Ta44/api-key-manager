<Window x:Class="ApiKeyManager.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ApiKeyManager.Wpf.Converters"
        xmlns:vm="clr-namespace:ApiKeyManager.Wpf.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="API Key 管理器"
        Width="{StaticResource WindowWidth}"
        Height="{StaticResource WindowHeight}"
        MinWidth="{StaticResource WindowMinWidth}"
        MinHeight="{StaticResource WindowMinHeight}"
        Background="{DynamicResource Back}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
        <conv:ExpiryBrushConverter x:Key="ExpiryText" AsText="True" />

        <!--
          列宽定义：8 列固定像素，合计 1000。

          为什么不用 * 星号 + SharedSizeGroup：
          SharedSizeGroup 的语义是"列宽 = 组内所有元素的最大 DesiredWidth"，
          它会覆盖 * 的按比例分配，结果列被内容撑开、整体溢出容器
          （实测合计被撑到 1500+ DIP，右侧三列直接跑到窗口外）。
          固定像素 + 表头/行共用同一组常量，是 ListBox+ItemTemplate 表格最稳的做法。

          宽度预算：窗口 1600
            - PadWindow 左右 32 - 卡片边框 2 - 表头内边距 20 - 垂直滚动条 16
            = 1530 可用
          合计 1000 留足余量，因此窗口缩到约 1100 也不会裁列。
        -->
        <GridLength x:Key="ColName">150</GridLength>
        <GridLength x:Key="ColProvider">85</GridLength>
        <GridLength x:Key="ColKey">185</GridLength>
        <GridLength x:Key="ColUrl">170</GridLength>
        <GridLength x:Key="ColModel">105</GridLength>
        <GridLength x:Key="ColTags">100</GridLength>
        <GridLength x:Key="ColExpiry">95</GridLength>
        <GridLength x:Key="ColUpdated">110</GridLength>
    </Window.Resources>

    <Grid Margin="{StaticResource PadWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部品牌 + 账户操作 ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardFlat}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlyphBadge}" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource GlyphBadgeIcon}" Text="&#xE72E;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextTitle}" Text="API Key 管理器" />
                    <TextBlock Style="{StaticResource TextCaption}"
                               Text="本地加密 · 离线存储 · AES-256-GCM" />
                </StackPanel>

                <!-- 账户级操作：靠右、次要样式 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLock" Style="{StaticResource ButtonGhost}"
                            Content="锁定" Command="{Binding LockCommand}" />
                    <Button x:Name="BtnChangePassword" Style="{StaticResource ButtonGhost}"
                            Content="修改主密码" Margin="8,0,0,0"
                            Command="{Binding ChangePasswordCommand}" />
                    <Button x:Name="BtnTheme" Style="{StaticResource ButtonGhost}"
                            Content="{Binding ThemeLabel}" Margin="8,0,0,0"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="切换浅色 / 深色主题（无需重启，界面不重建）" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 第一行：动作按钮。窄窗口下自动换行，不会把按钮裁掉 -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ButtonPrimary}" Content="新增"
                            Margin="0,0,8,0" Command="{Binding AddCommand}" />

                    <Button Style="{StaticResource ButtonSubtle}" Content="编辑"
                            Margin="0,0,8,0" Command="{Binding EditCommand}" />
                    <Button Style="{StaticResource ButtonSubtle}" Content="删除"
                            Margin="0,0,8,0" Command="{Binding DeleteCommand}" />

                    <Rectangle Style="{StaticResource VerticalSep}" Height="20" Margin="2,0,10,0" />

                    <Button Style="{StaticResource ButtonSubtle}" Content="复制 Key"
                            Margin="0,0,8,0" Command="{Binding CopyKeyCommand}" />
                    <Button Style="{StaticResource ButtonSubtle}" Content="复制 URL"
                            Margin="0,0,8,0" Command="{Binding CopyUrlCommand}" />
                    <Button Style="{StaticResource ButtonSubtle}" Content="{Binding ToggleKeysLabel}"
                            Margin="0,0,8,0" Command="{Binding ToggleKeysCommand}" />

                    <Rectangle Style="{StaticResource VerticalSep}" Height="20" Margin="2,0,10,0" />

                    <Button Style="{StaticResource ButtonSubtle}" Content="导入"
                            Margin="0,0,8,0" Command="{Binding ImportCommand}" />
                    <Button Style="{StaticResource ButtonSubtle}" Content="导出备份"
                            Margin="0,0,8,0" Command="{Binding ExportBackupCommand}" />
                    <Button Style="{StaticResource ButtonDanger}" Content="导出 CSV"
                            Margin="0,0,0,0" Command="{Binding ExportCsvCommand}"
                            ToolTip="导出为明文 CSV，请谨慎使用" />
                </WrapPanel>

                <!-- 第二行：搜索 + 自动锁定。单独一行，避免与按钮争抢宽度 -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource TextDim}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="TxtSearch" Style="{StaticResource TextBoxSearch}"
                                 VerticalAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 AutomationProperties.Name="搜索记录"
                                 ToolTip="搜索名称 / 提供商 / 模型 / 标签 / Base URL" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TextFieldLabel}" Margin="0,0,8,0"
                                   Text="自动锁定（分钟，0=关）" />
                        <TextBox Style="{StaticResource TextBoxBase}"
                                 Width="{StaticResource WidthSpinner}" VerticalAlignment="Center"
                                 TextAlignment="Center"
                                 Text="{Binding AutoLockMinutes, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 列表卡片 ============ -->
        <!-- 列表卡片：内边距设为 0，由表头和行自己控制留白，
             否则 24+24 的内边距会把 8 列表格挤到溢出 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 表头：与 ItemTemplate 使用同一组固定像素列宽，保证严格对齐 -->
                <Border Grid.Row="0" Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource ColName}" />
                            <ColumnDefinition Width="{StaticResource ColProvider}" />
                            <ColumnDefinition Width="{StaticResource ColKey}" />
                            <ColumnDefinition Width="{StaticResource ColUrl}" />
                            <ColumnDefinition Width="{StaticResource ColModel}" />
                            <ColumnDefinition Width="{StaticResource ColTags}" />
                            <ColumnDefinition Width="{StaticResource ColExpiry}" />
                            <ColumnDefinition Width="{StaticResource ColUpdated}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TextHeaderCell}" Text="名称" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextHeaderCell}" Text="提供商" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TextHeaderCell}" Text="API Key" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TextHeaderCell}" Text="Base URL" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TextHeaderCell}" Text="模型" />
                        <TextBlock Grid.Column="5" Style="{StaticResource TextHeaderCell}" Text="标签" />
                        <TextBlock Grid.Column="6" Style="{StaticResource TextHeaderCell}" Text="到期日" />
                        <TextBlock Grid.Column="7" Style="{StaticResource TextHeaderCell}" Text="更新时间" />
                    </Grid>
                </Border>

                <!--
                  数据列表。
                  VirtualizingPanel 设置很关键：记录数上千时，
                  不开虚拟化会因为每行都是复杂模板而明显卡顿。
                -->
                <ListBox x:Name="EntryList" Grid.Row="1"
                         Style="{StaticResource PlainListBox}"
                         ItemsSource="{Binding Filtered}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="API Key 记录列表">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                            <Grid Height="{StaticResource HeightRow}" ToolTip="{Binding RowTooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColName}" />
                                    <ColumnDefinition Width="{StaticResource ColProvider}" />
                                    <ColumnDefinition Width="{StaticResource ColKey}" />
                                    <ColumnDefinition Width="{StaticResource ColUrl}" />
                                    <ColumnDefinition Width="{StaticResource ColModel}" />
                                    <ColumnDefinition Width="{StaticResource ColTags}" />
                                    <ColumnDefinition Width="{StaticResource ColExpiry}" />
                                    <ColumnDefinition Width="{StaticResource ColUpdated}" />
                                </Grid.ColumnDefinitions>

                                <!-- 名称 -->
                                <TextBlock Grid.Column="0" Style="{StaticResource TextCellStrong}"
                                           Text="{Binding Name}" ToolTip="{Binding Name}" />

                                <!-- 提供商 -->
                                <TextBlock Grid.Column="1" Style="{StaticResource TextCell}"
                                           Text="{Binding Provider}" />

                                <!-- API Key：等宽字体，便于核对字符 -->
                                <TextBlock Grid.Column="2" Style="{StaticResource TextCellMono}"
                                           Text="{Binding ApiKeyDisplay}" />

                                <!-- Base URL -->
                                <TextBlock Grid.Column="3" Style="{StaticResource TextCell}"
                                           Text="{Binding BaseUrl}" />

                                <!-- 模型 -->
                                <TextBlock Grid.Column="4" Style="{StaticResource TextCell}"
                                           Text="{Binding Model2}" />

                                <!-- 标签：彩色 chip（这是 ListBox+ItemTemplate 相对 DataGridView 的主要收益） -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding TagList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Chip}" Margin="0,0,4,0">
                                                    <TextBlock Style="{StaticResource ChipLabel}" Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                               Text="…" Visibility="{Binding HasHiddenTags, Converter={StaticResource BoolToVis}}"
                                               ToolTip="{Binding HiddenTagCount, StringFormat=另有 {0} 个标签}" />
                                </StackPanel>

                                <!-- 到期日：状态色 -->
                                <TextBlock Grid.Column="6" Style="{StaticResource TextCell}"
                                           Text="{Binding ExpiresDisplay}"
                                           ToolTip="{Binding ExpiryTooltip}"
                                           Foreground="{Binding ExpiryState, Converter={StaticResource ExpiryText}}" />

                                <!-- 更新时间 -->
                                <TextBlock Grid.Column="7" Style="{StaticResource TextCellDim}"
                                           Text="{Binding UpdatedDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态提示：列表为空时覆盖显示 -->
                <TextBlock Grid.Row="1" Style="{StaticResource TextEmptyState}"
                           Text="{Binding EmptyHint}"
                           IsHitTestVisible="False"
                           Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource TextCaption}"
                       Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,12,0"
                           Text="{Binding SummaryText}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Pill}">
                    <TextBlock Style="{StaticResource PillLabel}"
                               Text="{Binding AutoLockPillText, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
