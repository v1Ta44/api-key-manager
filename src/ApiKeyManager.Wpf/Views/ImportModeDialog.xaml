<Window x:Class="ApiKeyManager.Wpf.Views.ImportModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入方式"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Back}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <!--
      高度由内容决定（SizeToContent），不写死。
      选项卡片放在 ScrollViewer 内，按钮放在它外面并固定底部 ——
      否则文案变长时「确定」会被挤出窗口，用户无法确认。
      根元素用 Grid 而非 StackPanel，避免"无限宽测量"把内层 * 列撑开。
    -->
    <Border Style="{StaticResource Card}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          MaxHeight="520"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Style="{StaticResource GlyphBadge}" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource GlyphBadgeIcon}" Text="&#xE896;" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextDialogTitle}" Text="导入方式" />
                    <TextBlock x:Name="TxtSummary" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 三个选项做成可点选的卡片，比 Yes/No/Cancel 消息框清晰得多 -->
            <RadioButton x:Name="OptReplace" GroupName="Mode" IsChecked="False" Margin="0,0,0,8">
                <Border Style="{StaticResource Card}" Padding="14" Background="{DynamicResource SurfaceAlt}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="替换当前库" />
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="清空当前库后写入备份内容。覆盖前会自动把当前库备份为 vault.akv.&lt;时间戳&gt;.bak" />
                    </StackPanel>
                </Border>
            </RadioButton>

            <RadioButton x:Name="OptMerge" GroupName="Mode" IsChecked="True" Margin="0,0,0,8">
                <Border Style="{StaticResource Card}" Padding="14" Background="{DynamicResource SurfaceAlt}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="合并到当前库" />
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="保留当前全部记录，只新增不重复的条目（按 Id 去重）" />
                    </StackPanel>
                </Border>
            </RadioButton>

            <RadioButton x:Name="OptCancel" GroupName="Mode" Margin="0,0,0,0">
                <Border Style="{StaticResource Card}" Padding="14" Background="{DynamicResource SurfaceAlt}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="放弃导入" />
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Text="不做任何修改" />
                    </StackPanel>
                </Border>
            </RadioButton>
        </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnOk" Style="{StaticResource ButtonPrimary}"
                        Content="确定" Width="88" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
