<Window x:Class="ApiKeyManager.Wpf.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请输入密码"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Back}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <!--
      布局要点（这里踩过坑，记下来避免重犯）：

      1. 窗口高度不写死，用 SizeToContent="Height" 由内容决定。
         三种模式显示的字段数不同（Ask 1 个 / Create 2 个 / Change 3 个），
         写死高度必然对某个模式不够 —— 表现就是底部「确定」按钮被裁掉一截。

      2. 按钮行必须在 ScrollViewer **外面**。
         最初的写法是 ScrollViewer 包住整张卡片（含按钮），
         一旦内容超高，按钮会跟着一起滚出可视区 —— 用户看不到「确定」，
         等于弹窗卡死。正确结构是"可滚动内容 + 固定底部按钮"。

      3. 根元素用 Grid 而不是 StackPanel。
         垂直 StackPanel 以"无限宽"测量子项，内层 Grid 的 * 列
         会展开到内容自然宽度而不收缩，导致内容横向溢出。
         Grid 会把约束宽度正常往下传。

      4. 不用 ScrollViewer 包宽度：靠 Grid 的 * 列自然换行即可，
         也就不需要 ViewportWidth 绑定那种脆弱写法。
    -->
    <Border Style="{StaticResource Card}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 可滚动区：标题 + 提示 + 字段 ============ -->
            <ScrollViewer Grid.Row="0"
                          MaxHeight="520"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 标题 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource GlyphBadge}" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource GlyphBadgeIcon}" Text="&#xE72E;" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTitle" Style="{StaticResource TextDialogTitle}" Text="解锁" />
                            <TextBlock x:Name="TxtSubtitle" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 提示 -->
                    <TextBlock x:Name="TxtPrompt" Style="{StaticResource TextBody}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <!-- 字段 1 -->
                    <TextBlock x:Name="LblPwd1" Style="{StaticResource TextCaption}" Margin="0,0,0,4" Text="主密码" />
                    <PasswordBox x:Name="Pwd1" Style="{StaticResource PasswordBoxBase}" />

                    <!-- 字段 2（Change 模式 = 新密码；Create 模式 = 确认密码） -->
                    <StackPanel x:Name="Block2" Visibility="Collapsed">
                        <TextBlock x:Name="LblPwd2" Style="{StaticResource TextCaption}" Margin="0,12,0,4" />
                        <PasswordBox x:Name="Pwd2" Style="{StaticResource PasswordBoxBase}" />
                    </StackPanel>

                    <!-- 字段 3（仅 Change 模式 = 确认新密码） -->
                    <StackPanel x:Name="Block3" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,12,0,4" Text="再次输入新密码以确认" />
                        <PasswordBox x:Name="Pwd3" Style="{StaticResource PasswordBoxBase}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 校验提示（固定，不随内容滚动） ============ -->
            <TextBlock x:Name="TxtError" Grid.Row="1"
                       Style="{StaticResource TextCaption}"
                       Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

            <!-- ============ 按钮（固定底部，永远不会被滚走） ============ -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnCancel" Style="{StaticResource ButtonSubtle}"
                        Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True"
                        AutomationProperties.Name="取消" />
                <Button x:Name="BtnOk" Style="{StaticResource ButtonPrimary}"
                        Content="确定" Width="88" IsDefault="True"
                        AutomationProperties.Name="确定" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
