<!--
  Light.xaml —— 浅色主题调色板

  颜色值沿用 WinForms 版 Palette 的实测值，保证视觉连续性；
  另外补齐原版缺的语义色（悬停/选中/危险/标签 chip/到期状态），
  这些在 WinForms 里是靠单元格染色硬编码出来的。

  命名约定：以 Color 结尾的是 Color 资源，其余是 SolidColorBrush。
  所有 Color 先声明，Brush 后引用，避免 StaticResource 前向引用失败。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 1. 原始颜色 ==================== -->
    <Color x:Key="ColorBack">#F4F6F9</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceAlt">#F0F2F6</Color>
    <Color x:Key="ColorBorder">#E2E6EC</Color>

    <Color x:Key="ColorText">#1E2432</Color>
    <Color x:Key="ColorTextDim">#707886</Color>
    <Color x:Key="ColorTextDisabled">#A8B0BC</Color>

    <Color x:Key="ColorAccent">#505FE8</Color>
    <Color x:Key="ColorAccentHover">#4251D8</Color>
    <Color x:Key="ColorAccentPressed">#3644C0</Color>
    <Color x:Key="ColorAccentSoft">#E9EDFF</Color>

    <Color x:Key="ColorDanger">#D24646</Color>
    <Color x:Key="ColorDangerHover">#BA3838</Color>
    <Color x:Key="ColorDangerSoft">#FDECEC</Color>
    <Color x:Key="ColorWarning">#C77B18</Color>
    <Color x:Key="ColorWarningSoft">#FFF4E0</Color>
    <Color x:Key="ColorSuccess">#2E9E63</Color>
    <Color x:Key="ColorSuccessSoft">#E7F7EE</Color>

    <Color x:Key="ColorHover">#F0F2F6</Color>
    <Color x:Key="ColorPressed">#E4E8F0</Color>
    <Color x:Key="ColorSelection">#E8ECFF</Color>
    <Color x:Key="ColorSelectionBorder">#C3CCFF</Color>

    <Color x:Key="ColorRowHover">#F7F9FC</Color>
    <Color x:Key="ColorRowZebra">#FAFBFD</Color>
    <Color x:Key="ColorGridLine">#ECEFF4</Color>

    <Color x:Key="ColorChipBack">#EDF0F7</Color>
    <Color x:Key="ColorChipText">#5A6474</Color>
    <Color x:Key="ColorPillBack">#E9EDFF</Color>

    <Color x:Key="ColorScrollThumb">#C8CED8</Color>
    <Color x:Key="ColorScrollThumbHover">#A8B0BC</Color>

    <!-- 标题栏：与窗体背景同色，让卡片看起来"浮"在窗口上 -->
    <Color x:Key="ColorCaption">#F4F6F9</Color>

    <!-- 阴影（带 alpha） -->
    <Color x:Key="ColorShadow">#221E2432</Color>

    <!-- ==================== 2. 语义画刷 ==================== -->
    <SolidColorBrush x:Key="Back" Color="{StaticResource ColorBack}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource ColorBorder}" />

    <SolidColorBrush x:Key="Text" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource ColorTextDim}" />
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource ColorTextDisabled}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Danger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="DangerHover" Color="{StaticResource ColorDangerHover}" />
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource ColorDangerSoft}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="WarningSoft" Color="{StaticResource ColorWarningSoft}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="SuccessSoft" Color="{StaticResource ColorSuccessSoft}" />

    <SolidColorBrush x:Key="Hover" Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="Pressed" Color="{StaticResource ColorPressed}" />
    <SolidColorBrush x:Key="Selection" Color="{StaticResource ColorSelection}" />
    <SolidColorBrush x:Key="SelectionBorder" Color="{StaticResource ColorSelectionBorder}" />
    <SolidColorBrush x:Key="FocusRing" Color="{StaticResource ColorAccent}" />

    <SolidColorBrush x:Key="RowHover" Color="{StaticResource ColorRowHover}" />
    <SolidColorBrush x:Key="RowZebra" Color="{StaticResource ColorRowZebra}" />
    <SolidColorBrush x:Key="GridLine" Color="{StaticResource ColorGridLine}" />

    <SolidColorBrush x:Key="ChipBack" Color="{StaticResource ColorChipBack}" />
    <SolidColorBrush x:Key="ChipText" Color="{StaticResource ColorChipText}" />

    <SolidColorBrush x:Key="PillBack" Color="{StaticResource ColorPillBack}" />
    <SolidColorBrush x:Key="PillText" Color="{StaticResource ColorAccent}" />

    <SolidColorBrush x:Key="ExpiryExpired" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="ExpirySoon" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="ExpiryValid" Color="{StaticResource ColorTextDim}" />
    <SolidColorBrush x:Key="ExpiryNone" Color="{StaticResource ColorTextDisabled}" />

    <SolidColorBrush x:Key="ScrollThumb" Color="{StaticResource ColorScrollThumb}" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="{StaticResource ColorScrollThumbHover}" />

    <SolidColorBrush x:Key="Caption" Color="{StaticResource ColorCaption}" />

</ResourceDictionary>
