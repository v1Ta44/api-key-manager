<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ApiKeyManager.Wpf</RootNamespace>
    <AssemblyName>ApiKeyManager</AssemblyName>

    <Product>API Key 管理器</Product>
    <AssemblyTitle>API Key 管理器</AssemblyTitle>
    <Description>本地加密的 API Key 管理小工具</Description>
    <Company>Local</Company>
    <Version>2.0.0</Version>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>

    <ApplicationIcon Condition="Exists('icon.ico')">icon.ico</ApplicationIcon>
    <!-- 多显示器不同缩放下的正确 DPI 行为 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <StartupObject>ApiKeyManager.Wpf.App</StartupObject>

    <!--
      发布设置。两种形态实测结果（Release / win-x64 / 单文件）：

        框架依赖 (SelfContained=false)  0.29 MB
          需要目标机安装 .NET 9 Desktop Runtime。
          体积和原 WinForms 版相当，作为默认发布形态。

        自包含   (SelfContained=true)  61.9 MB
          免安装运行时，但 WPF 的原生渲染组件
          （D3DCompiler_47_cor3 / wpfgfx_cor3 / PresentationNative_cor3 / PenImc_cor3）
          无法并入单文件，所以成品是 exe + 4 个 DLL。

      注意：WPF 不支持 PublishTrimmed，开启会得到
      NETSDK1168（官方明确说明不支持裁剪 WPF），因此这里的 61.9 MB 已是下限。

      两种形态都放在 publish-profiles 里，用 -p:PublishProfile=<名字> 选择。
    -->
    <!--
      发布默认值。
      注意这些都只在 Publish 时生效（用 '$(PublishProfile)' 或显式传参覆盖）：
      如果直接在 PropertyGroup 里设 RuntimeIdentifier，普通 build 的输出
      也会多出一层 win-x64 子目录，破坏 bin\Debug\net9.0-windows\ 这个惯例路径，
      让所有按惯例路径写死的脚本和文档失效。
      因此这里不设 RuntimeIdentifier，由发布命令显式指定 -r win-x64。
    -->
    <DebugType>none</DebugType>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <!-- 压缩只支持自包含发布；框架依赖版开启会得到 NETSDK1176 -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiKeyManager.Core\ApiKeyManager.Core.csproj" />
  </ItemGroup>

  <!-- 构建脚手架（makeicon / glyphcheck 命令行分支）需要 System.Drawing 来生成 PNG/ICO。
       WPF 在 net9.0-windows 下默认不包含 System.Drawing.Common，需要显式引用。
       这些类型只在命令行分支里用到，不参与 GUI 运行时路径。 -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\IconFactory.cs" Link="Tools\IconFactory.cs" />
    <Compile Include="..\..\SelfTest.cs" Link="Tools\SelfTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\icon.ico" Link="Assets\icon.ico" Condition="Exists('..\..\icon.ico')" />
  </ItemGroup>

</Project>
